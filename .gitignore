# Uretilmis bridge dosyalari BILEREK depoda tutuluyor (eskiden burada
# yok sayiliyordu). Ureten arac GitHub'dan indiriliyor; depoda olmazlarsa
# temiz bir klon internet olmadan derlenemez. Eskime tehlikesini
# tools/bridge.stamp + derleme kapisi karsiliyor.
# ============================================================
# SkyDesk fork eklemeleri
# ============================================================
# Upstream'in *png / *svg / *jpg kurali marka varliklarimizi da eliyordu;
# ikon ve logolar bu forkun ta kendisi, versiyonlanmalari sart.

# derleme ciktilari ve ephemeral flutter dizinleri
/target/
/flutter/build/
/flutter/windows/flutter/
/flutter/linux/flutter/
/logs/
/skydesk

# elle alinmis arsiv kopyalari (upstream *deb/*exe kaliplarina takilmayanlar)
*.bak-*
*.old-*

# marka varliklari: upstream'in genel gorsel yasagindan muaf
!res/**/*.png
!res/**/*.svg
!res/**/*.ico
!res/**/*.jpg
!flutter/assets/**
!flutter/android/**/*.png
!flutter/ios/**/*.png
!flutter/macos/**/*.png
!flutter/web/**/*.png

# Derleme sirasinda uretilir, kaynak degil
libs/portable/app_metadata.toml

# --- Windows build kutusunda biriken artiklar ---
/vcpkg/
*.rustdesk-bak
*.rd-bak
res.bak-fd/
*.msi
*.wixpdb

# Mağaza görselleri depoda durur; listelemeyi yükleyen kişi bunları depodan
# alıyor. Yukarıdaki kök *png kuralı sessizce bunları da eliyordu — ikon ile
# öne çıkan görsel bir süre "hazır" sanıldı, oysa hiç commit edilmemişlerdi.
!fastlane/metadata/**/*.png

# Derleme ciktilari: agacta durmalari pariteyi bozuk gosteriyordu ve
# ikisi emekli marka adiyla duruyordu (FixDesk, tek y SkyDesk).
*.apk
*.aab
/SkyyDesk-Embed-Android.aar
