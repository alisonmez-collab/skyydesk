	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportsDocumentBrowser</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- ITSAppUsesNonExemptEncryption bilerek YOK.
	     Oturumlar uctan uca sifreli (libsodium/NaCl), yani beyan "muaf olmayan
	     sifreleme kullaniyor" (eskiden burada true yaziyordu, o dogruydu). Ama
	     anahtar true iken App Store Connect yuklemede ITSEncryptionExportComplianceCode
	     da istiyor (hata 90592); o kod ancak onayli sifreleme belgesiyle verilir.
	     Anahtar yokken ayni beyan her build icin App Store Connect'te yapiliyor:
	     "Standard encryption algorithms", Fransa'da yayin yok. Bkz. docs/IOS_YAYIN.md.
	     "false" YAZMAYIN: yanlis beyan olur. -->
	<key>io.flutter.embedded_views_preview</key>
  <true/>
  <key>NSCameraUsageDescription</key>
  <string>This app needs camera access to scan QR codes</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>This app needs photo library access to get QR codes from image</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
