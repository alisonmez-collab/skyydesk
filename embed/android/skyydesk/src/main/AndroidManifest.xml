<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the application's manifest. The application still asks for
     POST_NOTIFICATIONS at run time on Android 13 and later. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14: a typed foreground service needs the matching permission.
         mediaProjection is screen capture (session audio included); microphone
         is claimed only during a voice call, see CaptureService.startForegroundWithTypes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.skyydesk.embed.HostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name="com.elpo.skyydesk.InputService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/skyydesk_input_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/skyydesk_accessibility_service" />
        </service>

        <activity
            android:name="com.elpo.skyydesk.PermissionRequestTransparentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
